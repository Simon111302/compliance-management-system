{
  "name": "my-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\" \"server/**/*.js\" \"*.{js,json,css,html}\"",
