{
  "name": "my-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.js",
    "dev:api": "node backend/src/server.js",
    "build": "vite build --config frontend/vite.config.js",
    "format": "prettier --write \"frontend/src/**/*.{js,jsx,css,json}\" \"backend/src/**/*.js\" \"frontend/*.{js,json,css,html}\" \"*.{js,json,css,html}\"",
    "format:check": "prettier --check \"frontend/src/**/*.{js,jsx,css,json}\" \"backend/src/**/*.js\" \"frontend/*.{js,json,css,html}\" \"*.{js,json,css,html}\"",
    "lint": "oxlint frontend/src backend/src",
    "preview": "vite preview --config frontend/vite.config.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongodb": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.0"
  }
}
