{
  "name": "my-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "dev:api": "tsx watch backend/src/server.ts",
    "start:api": "node backend/dist/server.js",
    "build": "npm run typecheck && npm run build:frontend && npm run build:api",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "build:api": "tsc --project backend/tsconfig.json",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:api",
    "typecheck:frontend": "tsc --project frontend/tsconfig.json --noEmit",
    "typecheck:api": "tsc --project backend/tsconfig.json --noEmit",
    "format": "prettier --write \"frontend/src/**/*.{ts,tsx,css,json}\" \"backend/src/**/*.{ts,d.ts}\" \"frontend/*.{ts,json,css,html}\" \"*.{json,css,html}\"",
    "format:check": "prettier --check \"frontend/src/**/*.{ts,tsx,css,json}\" \"backend/src/**/*.{ts,d.ts}\" \"frontend/*.{ts,json,css,html}\" \"*.{json,css,html}\"",
    "lint": "oxlint frontend/src backend/src",
    "preview": "vite preview --config frontend/vite.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongodb": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
